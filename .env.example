DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

ANTHROPIC_API_KEY="sk-ant-..."

# base64 of the bcrypt hash of the parent PIN (plain PIN is never stored).
# base64-encoded because Next.js's env loader mangles literal $ characters.
# Generate with: node -e "console.log(Buffer.from(bcrypt_hash).toString('base64'))"
PARENT_PIN_HASH_B64="..."

# shared secret required in the X-Job-Secret header to call /api/jobs/*
JOB_SECRET="generate-a-random-string"

# SES / reports - fill in for Phase 3
SES_FROM_EMAIL=""
PARENT_EMAIL=""
