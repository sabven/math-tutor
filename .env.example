DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# A separate Neon branch dedicated to the test suite (tests/) - never point
# this at production. Create with: npx neonctl branches create --project-id
# <id> --name test, then copy the connection_uri it prints.
DATABASE_URL_TEST="postgresql://user:password@host/dbname?sslmode=require"

ANTHROPIC_API_KEY="sk-ant-..."

# signs the family_session cookie (HMAC). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="generate-a-random-string"

# base64 of the bcrypt hash of the admin password. Gates /admin (family
# account creation), separate from any family login. base64-encoded because
# Next.js's env loader mangles literal $ characters in a raw bcrypt hash.
# Generate with: node -e "console.log(Buffer.from(bcrypt_hash).toString('base64'))"
ADMIN_PASSWORD_HASH_B64="..."

# shared secret required in the X-Job-Secret header to call /api/jobs/*
JOB_SECRET="generate-a-random-string"

# SES / reports - fill in for Phase 3
SES_FROM_EMAIL=""
PARENT_EMAIL=""
